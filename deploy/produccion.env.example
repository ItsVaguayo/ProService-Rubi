# .env de PRODUCCIÓN. preparar-servidor.sh lo copia a /etc/proservice/proservice.env (root:proservice, 640)
# y cada versión desplegada lo enlaza como .env. Las claves se ponen SOLO allí, nunca aquí ni en Git.
# Explicación de cada variable: .env.example y docs/produccion.md (sección 6).
NODE_ENV=production
PORT=3001
HOST=127.0.0.1
DB_PATH=/srv/proservice/datos/proservice.db
UPLOADS_PATH=/srv/proservice/datos/uploads
COPIAS_PATH=/srv/proservice/copias
COPIAS_DIAS=14
# Fuera del servidor (docs/despliegue.md, «Copias»): el remoto de /etc/proservice/rclone.conf, p. ej. copias:proservice
COPIAS_REMOTO=
CONTACTOS_POR_IP=5
SESION_DIAS=30
FOTOS_MINIMAS=15
CUOTA_TIN=7.5
CUOTA_MESES=120
# La web de WordPress (y su variante con www si la usa)
CORS_ORIGENES=https://proservicerubi.com,https://www.proservicerubi.com
PANEL_URL=https://stock.proservicerubi.com/panel/
# Correo: vacío = modo simulado (se apuntan en el panel, no salen). Ver dudas H13 y E1
SMTP_URL=
CORREO_DE=Pro Service Rubí <no-responder@proservicerubi.com>
CORREO_CONTACTOS=
CORREO_AVISOS=
AVISOS_HORA=8
# WordPress real (docs/web-real.md). WP_SINCRONIZAR_MINUTOS=0 hasta que esté resuelto B11 y vinculadas las fichas (B17)
WP_URL=https://proservicerubi.com
WP_USUARIO=
WP_CLAVE_APLICACION=
WP_SINCRONIZAR_MINUTOS=0
WP_TIPO=coches
WP_TAXONOMIA=marca
WP_FOTOS_POR_PASADA=40
WP_MAPA=
