# API
PORT=3001
DB_PATH=./data/proservice.db
# Orígenes con permiso CORS, separados por comas. Vacío = ninguno (el panel va por el proxy de Vite).
CORS_ORIGENES=
# Días que dura una sesión del panel
SESION_DIAS=30
# Fotos mínimas para poder publicar un coche (4.1)
FOTOS_MINIMAS=15
# production activa la cookie Secure (solo HTTPS). Detrás de nginx con HTTPS se activa sola igualmente
NODE_ENV=development
# WordPress de la web, por su API REST (usuario Editor + contraseña de aplicación). Ver wordpress-pruebas/README.md
WP_URL=
WP_USUARIO=
WP_CLAVE_APLICACION=
# Publicar sola cada N minutos (0 = solo a mano)
WP_SINCRONIZAR_MINUTOS=0
# Copias de seguridad (npm run copia --workspace api, una vez al día con cron)
COPIAS_PATH=./data/copias
COPIAS_DIAS=14
# Correo (api/src/modules/correo/envio.js). Sin SMTP_URL, modo simulado: se apuntan y se ven en GET /api/correos, pero no salen
SMTP_URL=
CORREO_DE=Pro Service Rubí <no-responder@proservicerubi.com>
# A quién le llega cada contacto de la web (varios, separados por comas)
CORREO_CONTACTOS=
# A quién le llega el resumen diario de avisos (lleva importes: solo gerencia) y a partir de qué hora de Rubí
CORREO_AVISOS=
AVISOS_HORA=8
# Dirección del panel, para los enlaces de los correos
PANEL_URL=
