# API
PORT=3001
DB_PATH=./data/proservice.db
# Orígenes con permiso CORS, separados por comas. Vacío = ninguno (el panel va por el proxy de Vite).
CORS_ORIGENES=
# Días que dura una sesión del panel
SESION_DIAS=30
# Fotos mínimas para poder publicar un coche (4.1)
FOTOS_MINIMAS=15
# production activa la cookie Secure (solo HTTPS)
NODE_ENV=development
