# API. Escucha solo en la propia máquina (127.0.0.1): desde fuera se entra por nginx. HOST=0.0.0.0 para abrirla
PORT=3001
HOST=127.0.0.1
DB_PATH=./data/proservice.db
# Fotos de los coches y de las tasaciones (en producción, fuera de la carpeta del código)
UPLOADS_PATH=./data/uploads
# Formularios de la web (contactos y citas) por IP cada 10 minutos
CONTACTOS_POR_IP=5
# Orígenes con permiso CORS, separados por comas. Vacío = ninguno (el panel va por el proxy de Vite).
CORS_ORIGENES=
# Días que dura una sesión del panel
SESION_DIAS=30
# Fotos mínimas para poder publicar un coche (4.1)
FOTOS_MINIMAS=15
# production activa la cookie Secure (solo HTTPS). Detrás de nginx con HTTPS se activa sola igualmente
NODE_ENV=development
# WordPress de la web, por su API REST (usuario Editor + contraseña de aplicación). Ver wordpress-pruebas/README.md
WP_URL=
WP_USUARIO=
WP_CLAVE_APLICACION=
# Publicar sola cada N minutos (0 = solo a mano)
WP_SINCRONIZAR_MINUTOS=0
# Tipo de post y taxonomía de los coches en su WordPress, y fotos que se suben en cada pasada
WP_TIPO=coches
WP_TAXONOMIA=marca
WP_FOTOS_POR_PASADA=40
# Campos de ACF con otro nombre: JSON con la forma de MAPA_POR_DEFECTO (api/src/modules/publicacion/wordpress.js). Vacío = el de por defecto
WP_MAPA=
# Cuota orientativa «Desde X €/mes» de la web y los portales: interés anual en % (con punto) y meses. CUOTA_MESES=0 la apaga
CUOTA_TIN=7.5
CUOTA_MESES=120
# Copias de seguridad (npm run copia --workspace api, una vez al día con cron)
COPIAS_PATH=./data/copias
COPIAS_DIAS=14
# Destino de rclone para sacar las copias del servidor (p. ej. copias:proservice). Vacío = solo dentro. Ver docs/despliegue.md
COPIAS_REMOTO=
# Correo (api/src/modules/correo/envio.js). Sin SMTP_URL, modo simulado: se apuntan y se ven en GET /api/correos, pero no salen
SMTP_URL=
CORREO_DE=Pro Service Rubí <no-responder@proservicerubi.com>
# A quién le llega cada contacto de la web (varios, separados por comas)
CORREO_CONTACTOS=
# A quién le llega el resumen diario de avisos (lleva importes: solo gerencia) y a partir de qué hora de Rubí
CORREO_AVISOS=
AVISOS_HORA=8
# Dirección del panel, para los enlaces de los correos
PANEL_URL=

# Solo para el sistema de pruebas (npm run dev:pruebas): NUNCA en producción
# SERVIR_FRONTEND=   sirve las maquetas desde la API
# ACCESO_PRUEBAS=    los usuarios de prueba en GET /api/pruebas/acceso (con NODE_ENV=production no sale)
